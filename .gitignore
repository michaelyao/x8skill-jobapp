node_modules/
dist/
logs/
data/
.DS_Store
# .env* , not .env — an exact-match rule let .env.save be committed with live API keys and the
# session secret in it, and it stayed tracked for months. Anything that starts with .env is a
# credential file until proven otherwise. (If a .env.example is ever wanted, negate it with
# "!.env.example" rather than narrowing this back.)
.env*
.x8note.config

# Browser profiles — these hold live Google/ATS session cookies, Login Data and
# Trust Tokens. Ignore the WHOLE directory: ".auth/" alone missed the timestamped
# ".auth.bak-*" copies the runner leaves behind (~250MB of credentials each).
playwright/

# personal files — never commit resume, transcript, profile text, or Q&A
*.pdf
text version.txt
Q&A.txt
# generated from Q&A.txt — contains home address and EEO self-ID answers
Q&A.md
nathan resume 2026.md
nathan resume 2026.txt
resumes.config

# run artifacts (per-run logs at the repo root; logs/ covers the run dirs)
*.log

# generated job data — rebuilt each run from job_sites.txt
internships_summer2027.csv
internships_summer2027.md
available_openings.md

# ad-hoc DOM-inspection scratch; the keepers live in src/debug/
_*.mjs
_*.ts


# worker/console runtime state (regenerated)
data/commands/
data/worker-status.json
data/.browser.lock
web/.next/
web/node_modules/
web/next-env.d.ts
web/.env*
web/tsconfig.tsbuildinfo
data/rounds/
data/learned-answers.json

# Screenshots of live application forms — they show a real name, employer and education.
screenshots/

# Nathan's college application essays — personal writing, kept for background only. Never committed,
# for the same reason the resume, Q&A.txt and the transcript are not: this is the candidate's data,
# not the project's.
college_app/
