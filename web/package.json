{
  "name": "x8skill-jobapp-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "JOBAPP_ROOT=$(cd .. && pwd) next dev -H ${WEB_HOST:-127.0.0.1} -p ${WEB_PORT:-3010}",
