{
  "name": "x8skill-jobapp",
  "version": "1.0.0",
  "description": "Playwright + TypeScript job application automation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "hash-password": "node tools/hash-password.mjs",
    "cmd": "tsx src/cli.ts",
    "test:skills": "tsx src/debug/skillPromptCases.ts",
    "test:skill-removal": "tsx src/debug/skillRemovalCases.ts",
    "test:longlist": "tsx src/debug/longListCases.ts",
    "test:sources": "node tools/build_internships.mjs --selftest",
    "test:ats": "tsx src/debug/atsDetectionCases.ts",
    "test:verifycode": "tsx src/debug/verifyCodeCases.ts",
    "test:sanity": "tsx src/debug/applicationSanityCases.ts",
    "test:history": "tsx src/debug/resumeHistoryCases.ts",
    "test:facts": "tsx src/debug/factCheckCases.ts",
    "test:visual": "tsx src/debug/visualCheckCases.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelyao/x8skill-jobapp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/michaelyao/x8skill-jobapp/issues"
  },
  "homepage": "https://github.com/michaelyao/x8skill-jobapp#readme",
  "dependencies": {
    "@types/node": "^25.5.0",
    "playwright": "^1.58.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
