{
  "name": "x8skill-jobapp",
  "version": "1.0.0",
  "description": "Playwright + TypeScript job application automation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
