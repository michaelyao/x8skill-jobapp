    "worker": "tsx src/worker.ts",
    "hash-password": "node tools/hash-password.mjs",
    "cmd": "tsx src/cli.ts",
    "test:skills": "tsx src/debug/skillPromptCases.ts",
    "test:skill-removal": "tsx src/debug/skillRemovalCases.ts",
    "test:longlist": "tsx src/debug/longListCases.ts",
    "test:reactselect": "tsx src/debug/reactSelectCases.ts",
    "test:enter": "tsx src/debug/enterSubmitCases.ts",
    "test:ashby": "tsx src/debug/ashbyYesNoCases.ts",
    "test:roleterm": "tsx src/debug/roleTermCases.ts",
    "test:eligibility": "tsx src/debug/eligibilityCases.ts",
    "test:titles": "tsx src/debug/titleFilterCases.ts",
    "test:upload": "tsx src/debug/uploadCases.ts",
    "test:sources": "node tools/build_internships.mjs --selftest",
    "test:ats": "tsx src/debug/atsDetectionCases.ts",
    "test:verifycode": "tsx src/debug/verifyCodeCases.ts",
    "test:sanity": "tsx src/debug/applicationSanityCases.ts",
    "test:history": "tsx src/debug/resumeHistoryCases.ts",
    "test:facts": "tsx src/debug/factCheckCases.ts",
    "test:address": "tsx src/debug/addressFieldCases.ts",
    "test:visual": "tsx src/debug/visualCheckCases.ts",
