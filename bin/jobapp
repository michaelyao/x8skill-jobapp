#!/bin/sh
# Terminal client for the job application worker. Enqueues a command for the daemon that
# owns Chrome — it never drives a browser itself, so it is safe to run at any time.
# JOBAPP_ROOT is what lets config.ts find the repo from wherever you happen to be standing.
JOBAPP_ROOT="$(cd "$(dirname "$(readlink "$0" || echo "$0")")/.." && pwd)"
export JOBAPP_ROOT
exec npx --prefix "$JOBAPP_ROOT" --no-install tsx "$JOBAPP_ROOT/src/cli.ts" "$@"
